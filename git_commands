git --version
//This command is used for printing the version.

git config --list
//This command will list the configuration of git in current system.

git config --global user.name "username"
//This command will configure the username of the GitHub.

git config --global email.name "email"
//This command will configure the email of the GitHub.

git init
//This command is used for initializing a folder as git directory.

git add <file name/./--all>
//This command is used for adding all the untracked files into the staging area.

git commit -m "message"
//This command is used to add a message to the git repository and move it to local repo.

git push -u origin <branch>
//This command is used to move a repository to a branch.

git status
//This command is used to show the status of the git or to show the untracked files.

git clone url
//This command is used to clone a remote repo to a local repo.

git branch
//This command is used to display all the branches in the current git.

git checkout -b <Branch name>
//This command is used to create a new branch.

git checkout <Branch name>
//This command is used to change the current branch to a existing branch.

